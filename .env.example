# مفتاح Anthropic API (من console.anthropic.com). بدونه تشتغل المنصة في الوضع التجريبي.
ANTHROPIC_API_KEY=

# النماذج (اختياري)
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# رمز دخول لوحة الأمانة (اختياري، ينصح به عند النشر)
ADMIN_PIN=

# تخزين دائم للوحة الأمانة ولترجمات الواجهة عبر Upstash Redis (اختياري).
# بدونه تُحفظ في الذاكرة وتُمسح عند إعادة التشغيل، فتُترجم الواجهة من جديد.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 1 = تشغيل الوضع التجريبي حتى لو وُجد المفتاح
MOCK=
